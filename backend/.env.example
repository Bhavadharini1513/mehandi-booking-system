# ---------- Server ----------
PORT=5000
NODE_ENV=development

# Local MongoDB (or a MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/mehandi

JWT_SECRET=change_this_to_a_long_random_string

# Used by `npm run create-admin`
ADMIN_EMAIL=admin@mehandi.com
ADMIN_PASSWORD=Admin@123

# URL of the React app (used in e-mail links and CORS)
CLIENT_URL=http://localhost:5173

# Business time zone and opening hours used by the booking calendar
APP_TZ=Asia/Kolkata
OPEN_HOUR=8
CLOSE_HOUR=22

# ---------- E-mail (optional) ----------
# Leave empty => e-mails (including the password reset link) are printed in the server console.
# For Gmail create an "App password" and use smtp.gmail.com / 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------- Payments (optional) ----------
# Leave empty => DEMO payment (no real money).
# Add your Razorpay TEST keys to use the real Razorpay checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
